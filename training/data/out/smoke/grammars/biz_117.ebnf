c_has_data_kw ::= "concept=" expr
c_has_data ::= "has_data(" ws (c_has_data_pos (sep c_has_data_kw)* | c_has_data_kw (sep c_has_data_kw)*)? ws ")"
c_builtin ::= ("isinstance(" | "enumerate(" | "reversed(" | "sorted(" | "float(" | "print(" | "range(" | "round(" | "tuple(" | "bool(" | "dict(" | "list(" | "abs(" | "all(" | "any(" | "int(" | "len(" | "max(" | "min(" | "set(" | "str(" | "sum(" | "zip(") ws args? ws ")"
c_misc ::= ("Unanswerable(" | "Period(" | "pd.Timestamp(" | "pd.to_datetime(" | "pd.DataFrame(" | "pd.Series(" | "pd.Timedelta(" | "np.round(" | "math.floor(" | "math.ceil(") ws args? ws ")"
