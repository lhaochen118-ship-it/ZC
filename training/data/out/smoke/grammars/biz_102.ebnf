c_period ::= "period(" ws (c_period_pos (sep c_period_kw)* | c_period_kw (sep c_period_kw)*)? ws ")"
c_rule_pos ::= expr
c_rule_kw ::= "term=" expr
c_rule ::= "rule(" ws (c_rule_pos (sep c_rule_kw)* | c_rule_kw (sep c_rule_kw)*)? ws ")"
c_schema_pos ::= expr
c_schema_kw ::= "table=" expr
c_schema ::= "schema(" ws (c_schema_pos (sep c_schema_kw)* | c_schema_kw (sep c_schema_kw)*)? ws ")"
c_peek_pos ::= expr (sep expr (sep (lambda | ident))?)?
c_peek_kw ::= "table=" expr | "n=" expr | "where=" (lambda | ident)
c_peek ::= "peek(" ws (c_peek_pos (sep c_peek_kw)* | c_peek_kw (sep c_peek_kw)*)? ws ")"
c_explain_pos ::= expr
c_explain_kw ::= "code=" expr
c_explain ::= "explain(" ws (c_explain_pos (sep c_explain_kw)* | c_explain_kw (sep c_explain_kw)*)? ws ")"
c_check_pos ::= expr (sep expr)?
c_check_kw ::= "answer=" expr | "expected_type=" expr
c_check ::= "check(" ws (c_check_pos (sep c_check_kw)* | c_check_kw (sep c_check_kw)*)? ws ")"
c_help_pos ::= expr
c_help_kw ::= "name=" expr
c_help ::= "help(" ws (c_help_pos (sep c_help_kw)* | c_help_kw (sep c_help_kw)*)? ws ")"
c_has_data_pos ::= expr
c_has_data_kw ::= "concept=" expr
c_has_data ::= "has_data(" ws (c_has_data_pos (sep c_has_data_kw)* | c_has_data_kw (sep c_has_data_kw)*)? ws ")"
c_builtin ::= ("isinstance(" | "enumerate(" | "reversed(" | "sorted(" | "float(" | "print(" | "range(" | "round(" | "tuple(" | "bool(" | "dict(" | "list(" | "abs(" | "all(" | "any(" | "int(" | "len(" | "max(" | "min(" | "set(" | "str(" | "sum(" | "zip(") ws args? ws ")"
c_misc ::= ("Unanswerable(" | "Period(" | "pd.Timestamp(" | "pd.to_datetime(" | "pd.DataFrame(" | "pd.Series(" | "pd.Timedelta(" | "np.round(" | "math.floor(" | "math.ceil(") ws args? ws ")"
call ::= c_day | c_today_p | c_yesterday | c_between | c_month | c_month_noyear | c_quarter | c_quarter_noyear | c_year | c_this_month | c_prev_month_same_days | c_prev_month | c_same_month_last_year | c_this_week | c_last_week | c_last_n_days | c_ytd | c_until | c_months_back | c_month_seq | c_tet | c_before_tet | c_tet_of | c_lunar_to_solar | c_round_half_up | c_money | c_pct | c_growth | c_rank | c_canon_status | c_map_status | c_canon_payment | c_canon_channel | c_key | c_require | c_model_line | c_brand_of | c_split_vehicle | c_split_jobs | c_job_of | c_orders | c_lines | c_revenue | c_n_orders | c_cancel_rate | c_aov | c_daily_revenue | c_best_day | c_n_days_revenue_at_least | c_n_orders_revenue_at_least | c_monthly_revenue | c_best_month | c_item_qty | c_item_sales | c_top_items | c_customer_sales | c_top_customers | c_n_customers | c_staff_sales | c_debts | c_debt_total | c_debt_by_customer | c_n_debtors | c_top_debtors | c_debt_aging | c_debt_older_than | c_debt_flow | c_share | c_increasing | c_weekday_avg | c_peak_hour | c_size_qty | c_unsold_items | c_purchase_total | c_avg_purchase_price | c_supplier_ranking | c_top_supplier | c_import_minus_sales | c_purchased_qty_base | c_stock_at | c_stock_split | c_stock_value | c_lot_stock | c_lots_expiring | c_items_expiring | c_out_of_stock | c_nearest_expiry | c_price_on | c_price_change_date | c_price_effect | c_gross_profit | c_net_profit | c_n_delivery_trips | c_pct_customers | c_factor | c_delivered_qty | c_n_orders_by_trips | c_n_due_orders | c_devices_sold | c_device_sales | c_top_lines | c_device_share | c_avg_device_price | c_tradein_total | c_n_tradein_orders | c_tradein_share | c_payable_total | c_avg_payable | c_instalment_remaining | c_instalment_overdue | c_n_overdue_customers | c_terms_due | c_warranty_visits | c_warranty_rate | c_warranty_sales | c_top_warranty_lines | c_devices_with_warranty | c_n_tickets | c_job_tickets | c_avg_ticket | c_n_vehicles | c_top_plates | c_vehicle_sales | c_top_vehic