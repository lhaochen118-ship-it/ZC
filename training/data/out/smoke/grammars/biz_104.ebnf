
root ::= "<plan>" plan "</plan>\n" body
plan ::= [^<\n]*
body ::= code | pyblock
code ::= "<code>\n" stmt* final "\n</code>"
stmt ::= (ident ws "=" ws expr | "print(" args? ")") "\n"
final ::= "ANSWER" ws "=" ws "{" q "type" q ":" ws atype ws "," ws q "answer" q ":" ws expr ws "}" | "raise Unanswerable(" anystr? ")"
q ::= "\"" | "'"
atype ::= "\"" atypename "\"" | "'" atypename "'"
atypename ::= "number" | "percent" | "string" | "date" | "boolean" | "list" | "table" | "unanswerable"
pyblock ::= "<python>\n" free "</python>"
sqlblock ::= "<sql>\n" free "</sql>"
free ::= [^\x00]*
ws ::= " "?
sep ::= "," " "?
expr ::= lambda | ternary
lambda ::= "lambda " ident ("," ws ident)* ":" ws expr
ternary ::= or_e (" if " or_e " else " expr)?
or_e ::= and_e (" or " and_e)*
and_e ::= not_e (" and " not_e)*
not_e ::= "not " not_e | cmp
cmp ::= arith (ws cmpop ws arith)*
cmpop ::= "==" | "!=" | "<=" | ">=" | "<" | ">" | "in" | "not in" | "is" | "is not"
arith ::= term (ws addop ws term)*
addop ::= "+" | "-" | "&" | "|"
term ::= factor (ws mulop ws factor)*
mulop ::= "*" | "/" | "//" | "%"
factor ::= ("-" | "~" | "+") factor | power
power ::= primary trailer* (ws "**" ws factor)?
primary ::= call | ident | number | anystr | listx | parenx | dictx | "None" | "True" | "False"
trailer ::= "." method "(" args? ")" | "." attr | "[" subs "]"
subs ::= slice (sep slice)*
slice ::= expr? ":" expr? | expr
method ::= "drop_duplicates" | "to_timestamp" | "value_counts" | "reset_index" | "sort_values" | "pct_change" | "sort_index" | "startswith" | "isoformat" | "normalize" | "nsmallest" | "to_period" | "contains" | "endswith" | "nlargest" | "quantile" | "strftime" | "between" | "groupby" | "notnull" | "nunique" | "replace" | "to_dict" | "to_list" | "weekday" | "astype" | "cumsum" | "dropna" | "fillna" | "idxmax" | "idxmin" | "isnull" | "median" | "tolist" | "unique" | "values" | "apply" | "count" | "first" | "index" | "items" | "lower" | "notna" | "query" | "round" | "split" | "strip" | "upper" | "where" | "clip" | "copy" | "date" | "diff" | "head" | "isin" | "isna" | "join" | "keys" | "last" | "mask" | "mean" | "prod" | "size" | "tail" | "abs" | "agg" | "all" | "any" | "get" | "loc" | "map" | "max" | "min" | "std" | "sum" | "eq" | "ge" | "gt" | "le" | "lt" | "ne"
attr ::= "dayofweek" | "is_unique" | "columns" | "values" | "empty" | "index" | "month" | "shape" | "start" | "days" | "hour" | "iloc" | "name" | "size" | "year" | "day" | "end" | "loc" | "str" | "dt" | "T"
args ::= arg (sep arg)* ","?
arg ::= ident "=" expr | "*" expr | "**" expr | expr
listx ::= "[" ws (expr (sep expr)* ","? | expr " for " target " in " or_e (" if " or_e)*)? ws "]"
parenx ::= "(" ws (expr (sep expr)* ","? | expr " for " target " in " or_e (" if " or_e)*)? ws ")"
dictx ::= "{" ws (expr ":" ws expr (sep expr ":" ws expr)* ","? | expr ":" ws expr " for " target " in " or_e (" if " or_e)*)? ws "}"
target ::= ident ("," ws ident)* | "(" ident ("," ws ident)* ")"
ident ::= [a-zA-Z_] [a-zA-Z0-9_]*
number ::= [0-9]+ ("_" [0-9]+)* ("." [0-9]+)? ([eE] [-+]? [0-9]+)?
anystr ::= "\"" ([^"\\\n] | "\\" [^\n])* "\"" | "'" ([^'\\\n] | "\\" [^\n])* "'"
int_e ::= expr

ent_item ::= "\"Bánh croissant\"" | "'Bánh croissant'" | "\"banh croissant\"" | "'banh croissant'" | "\"Bánh tiramisu\"" | "'Bánh tiramisu'" | "\"banh tiramisu\"" | "'banh tiramisu'" | "\"Bạc xỉu (L)\"" | "'Bạc xỉu (L)'" | "\"bac xiu l\"" | "'bac xiu l'" | "\"Bạc xỉu (M)\"" | "'Bạc xỉu (M)'" | "\"bac xiu m\"" | "'bac xiu m'" | "\"Cappuccino (L)\"" | "'Cappuccino (L)'" | "\"cappuccino l\"" | "'cappuccino l'" | "\"Cappuccino (M)\"" | "'Cappuccino (M)'" | "\"cappuccino m\"" | "'cappuccino m'" | "\"Cold brew (L)\"" | "'Cold brew (L)'" | "\"cold brew l\"" | "'cold brew l'" | "\"Cold brew (M)\"" | "'Cold brew (M)'" | "\"cold brew m\"" | "'cold brew m'" | "\"Cà phê muối (L)\"" | "'Cà phê muối (L)'" | "\"ca phe muoi l\"" | "'ca phe muoi l'" | "\"Cà phê muối (M)\"" | "'Cà phê muối (M)'" | "\"ca phe muoi m\"" | "'ca phe muoi m'" | "\"Cà phê sữa (L)\"" | "'Cà phê sữa (L)'" | "\"ca phe sua l\"" | "'ca phe sua l'" | "\"Cà phê sữa (M)\"" | "'Cà phê sữa (M)'" | "\"ca phe sua m\"" | "'ca phe sua m'" | "\"Cà phê đen (L)\"" | "'Cà phê đen (L)'" | "\"ca phe den l\"" | "'ca phe den l'" | "\"Cà phê đen (M)\"" | "'Cà phê đen (M)'" | "\"ca phe den m\"" | "'ca phe den m'" | "\"Espresso (double)\"" | "'Espresso (double)'" | "\"espresso double\"" | "'espresso double'" | "\"Espresso (single)\"" | "'Espresso (single)'" | "\"espresso single\"" | "'espresso single'" | "\"Hồng trà sữa (L)\"" | "'Hồng trà sữa (L)'" | "\"hong tra sua l\"" | "'hong tra sua l'" | "\"Hồng trà sữa (M)\"" | "'Hồng trà sữa (M)'" | "\"hong tra sua m\"" | "'hong tra sua m'" | "\"Latte (L)\"" | "'Latte (L)'" | "\"latte l\"" | "'latte l'" | "\"Latte (M)\"" | "'Latte (M)'" | "\"latte m\"" | "'latte m'" | "\"Matcha latte (L)\"" | "'Matcha latte (L)'" | "\"matcha latte l\"" | "'matcha latte l'" | "\"Matcha latte (M)\"" | "'Matcha latte (M)'" | "\"matcha latte m\"" | "'matcha latte m'" | "\"Nước ép cam (L)\"" | "'Nước ép cam (L)'" | "\"nuoc ep cam l\"" | "'nuoc ep cam l'" | "\"Nước ép cam (M)\"" | "'Nước ép cam (M)'" | "\"nuoc e